---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const talks = await getCollection('talks');
	return talks.map(entry => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const pageTitle = entry.data.pageTitle || `${entry.data.title} | Pablo`;
const hasResources = (entry.data.links && entry.data.links.length > 0) ||
	(entry.data.artifacts && entry.data.artifacts.length > 0) ||
	Boolean(entry.data.slides);

const talkImage = entry.data.artifacts && entry.data.artifacts.length > 0 
	? entry.data.artifacts[0].src 
	: undefined;
---

<Layout title={pageTitle} description={entry.data.description} image={talkImage}>
	<div class="mb-8">
		<a href="/talks" class="font-mono text-muted" style="font-size: 0.85rem;">&larr; Back</a>
	</div>

	<h1 class="mb-3">{entry.data.title}</h1>
	<p class="font-mono text-muted text-sm mb-8">{entry.data.subtitle}</p>

	{hasResources && <p style="display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 2rem; font-size: 0.9rem;">
		{entry.data.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.text} ↗</a>)}
		{entry.data.slides && <a href={entry.data.slides.src}>Slides ↗</a>}
	</p>}

	<div class="talk-content">
		<Content />
	</div>

</Layout>

<style is:global>
	.talk-content h2 {
		font-size: 1.45rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		margin-top: 3.5rem;
		margin-bottom: 1.25rem;
		color: var(--text-primary);
	}

	.talk-content h3 {
		font-size: 1.2rem;
		font-weight: 600;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	.talk-content p {
		color: var(--text-secondary);
		font-size: 0.98rem;
		line-height: 1.78;
		max-width: 780px;
		margin-bottom: 1.6rem;
	}

	.talk-content ol {
		color: var(--text-secondary);
		padding-left: 2rem;
		margin-top: 1.25rem;
		margin-bottom: 2rem;
		list-style-type: decimal;
		line-height: 1.78;
		font-size: 0.98rem;
		max-width: 780px;
	}

	.talk-content ul {
		color: var(--text-secondary);
		padding-left: 2rem;
		margin-top: 1.25rem;
		margin-bottom: 2rem;
		list-style-type: disc;
		line-height: 1.78;
		font-size: 0.98rem;
		max-width: 780px;
	}

	.talk-content li {
		margin-bottom: 0.65rem;
		padding-left: 0.4rem;
	}

	.talk-content li > p {
		margin-bottom: 0.5rem;
	}

	.talk-content strong {
		color: var(--text-primary);
	}

	.talk-content a {
		color: var(--accent-color);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.15s ease;
	}

	.talk-content a:hover {
		color: var(--accent-hover);
	}

	.talk-content img {
		display: block;
		margin: 2.25rem 0;
	}
</style>
