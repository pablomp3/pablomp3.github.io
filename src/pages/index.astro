---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/home.json';
import { getCollection } from 'astro:content';
const latest = (await getCollection('talks')).filter(item => !item.data.unlisted).sort ( (a, b) => b.data.timestamp.localeCompare(a.data.timestamp)).slice(0, 2);

const { hero, coffeeChat, engineeringFocus } = homeData;
---

<Layout title="Pablo Diéguez | Staff AI Engineer">
	<!-- HERO -->
	<div class="flex flex-col">
		<div class="hero-header">
			<div class="hero-copy">
				<h1 class="hero-name">{hero.title}</h1>
				<p class="hero-intro text-secondary" set:html={hero.intro} />
			</div>
			<img class="hero-photo" src="/assets/pablo-portrait.jpg" alt="Pablo" width="150" height="150" />
		</div>
		
		<details class="engineering-details" style="max-width: 650px; margin-bottom: 1.5rem;">
			<summary style="cursor: pointer;">More about my engineering work</summary>
			<div style="margin-top: 1rem;">
				<p class="text-secondary mb-4" set:html={engineeringFocus.lead} />
				<ul style="margin-left: 1.5rem;">
					{engineeringFocus.areas.map(area => <li style="margin-bottom: 1rem;"><strong>{area.title}</strong><div class="text-secondary" set:html={area.description} /></li>)}
				</ul>
			</div>
		</details>

		<div class="social-row text-secondary">
			<span class="social-label">Find me on:</span>
			{hero.socialLinks.map((link, idx) => (
				<>
					{idx > 0 && <span class="social-sep">•</span>}
					<a href={link.url} target={link.target || undefined} rel={link.target ? "noopener noreferrer" : undefined}>
						{link.name} ↗
					</a>
				</>
			))}
		</div>
	</div>

	<section class="latest-writing" style="max-width: 680px; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
		<h2 class="mb-4">Latest writing & talks</h2>
		{latest.map(item => <article class="talk-row" style="margin-bottom: 0.75rem;"><span class="font-mono text-muted talk-date">{item.data.date}</span><h3><a href={`/talk/${item.slug}`}>{item.data.title}</a></h3></article>)}
		<a href="/talks">All writing & talks →</a>
	</section>

	<!-- SAY HI / COFFEE CHAT -->
	<div style="max-width: 680px; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
		<div class="mb-6" style="background: var(--card-bg); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); max-width: 650px;">
			<h3 class="mb-3">{coffeeChat.title}</h3>
			<p class="mb-3 text-secondary" style="font-size: 0.95rem; line-height: 1.65;">
				{coffeeChat.description}
			</p>
			<p class="mb-4 text-secondary" style="font-size: 0.95rem; line-height: 1.65;" set:html={coffeeChat.mentorship} />
			<div class="flex flex-wrap gap-4 text-sm" style="margin-top: 1.5rem;">
				{coffeeChat.bookingLinks.map(b => (
					<a href={b.url} target="_blank" rel="noopener noreferrer" class="list-item" style="padding: 0.65rem 1.25rem; text-decoration: none;">
						{b.label}
					</a>
				))}
			</div>
		</div>
	</div>
</Layout>

<style>
	.hero-header {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		max-width: 650px;
		margin-bottom: 2rem;
	}

	.hero-copy { flex: 1; min-width: 0; }

	.hero-photo {
		flex: 0 0 112px;
		width: 112px;
		height: 112px;
		object-fit: cover;
		border-radius: 50%;
		border: 1px solid var(--border-color);
	}

	.hero-name {
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 1.15rem;
		color: var(--text-primary);
	}

	.hero-intro {
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 650px;
		margin-bottom: 0;
		color: var(--text-secondary);
	}

	.engineering-details summary { font-size: 0.95rem; }

	.hero-intro :global(strong) {
		color: var(--text-primary);
		font-weight: 600;
	}

	.engineering-section {
		max-width: 650px;
		margin-bottom: 1.75rem;
	}

	.focus-lead {
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.25rem;
		color: var(--text-secondary);
	}

	.focus-list {
		margin-left: 1.75rem;
		list-style-type: disc;
	}

	.focus-item {
		margin-bottom: 1.75rem;
		padding-left: 0.25rem;
	}

	.focus-title {
		display: block;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-primary);
		margin-bottom: 0.35rem;
	}

	.focus-desc {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.social-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.6rem;
		font-size: 0.9rem;
		font-family: inherit; /* Unify with Inter sans-serif */
		margin-top: 0.25rem;
	}

	.social-label {
		color: var(--text-muted);
	}

	.social-sep {
		color: var(--text-muted);
		opacity: 0.5;
	}

	@media (max-width: 640px) {
		.hero-header { gap: 1rem; align-items: center; }
		.hero-photo { width: 80px; height: 80px; flex-basis: 80px; }

		.hero-name {
			font-size: 1.55rem;
		}

		.hero-intro {
			font-size: 1rem;
			margin-bottom: 0;
		}

		.focus-lead {
			font-size: 0.92rem;
			margin-bottom: 1rem;
		}

		.focus-list {
			margin-left: 1.25rem;
		}

		.focus-item {
			margin-bottom: 1.5rem;
		}

		.focus-title {
			font-size: 0.98rem;
		}

		.focus-desc {
			font-size: 0.92rem;
		}

		.social-row {
			font-size: 0.85rem;
		}
	}
</style>
