---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/home.json';

const { hero, engineeringFocus, coffeeChat } = homeData;
---

<Layout title="Pablo | Machine Learning Engineer">
	<!-- HERO -->
	<div class="flex flex-col gap-4">
		<h1>{hero.title}</h1>
		<p class="text-secondary hero-intro" style="font-size: 1.05rem; max-width: 650px; line-height: 1.7;" set:html={hero.intro} />
		
		<div style="font-size: 1.05rem; max-width: 650px; line-height: 1.7; margin-top: -0.5rem;">
			<p class="mb-6 text-secondary" set:html={engineeringFocus.lead} />
			<ul class="text-secondary" style="margin-left: 2rem; list-style-type: disc;">
				{engineeringFocus.areas.map(area => (
					<li class="mb-8 pl-1">
						<strong class="text-primary block">{area.title}</strong>
						<div class="mt-1" set:html={area.description} />
					</li>
				))}
			</ul>
		</div>

		{hero.hobbies && <p class="text-secondary" style="font-size: 1.05rem; max-width: 650px; line-height: 1.7;" set:html={hero.hobbies} />}
		<div class="social-row font-mono text-secondary" style="margin-top: 0.5rem;">
			<span>Find me on:</span>
			{hero.socialLinks.map((link, idx) => (
				<>
					{idx > 0 && <span>•</span>}
					<a href={link.url} target={link.target || undefined} rel={link.target ? "noopener noreferrer" : undefined}>
						{link.name}
					</a>
				</>
			))}
		</div>
	</div>

	<!-- SAY HI / COFFEE CHAT -->
	<div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
		<div class="mb-6" style="background: var(--card-bg); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); max-width: 650px;">
			<h3 class="mb-3">{coffeeChat.title}</h3>
			<p class="mb-3 text-secondary" style="font-size: 1rem; line-height: 1.7;">
				{coffeeChat.description}
			</p>
			<p class="mb-4 text-secondary" style="font-size: 1rem; line-height: 1.7;" set:html={coffeeChat.mentorship} />
			<p class="mb-3 text-secondary" style="font-size: 1rem; font-weight: 500;">
				{coffeeChat.invitation}
			</p>
			<div class="flex flex-wrap gap-4 font-mono text-sm" style="margin-top: 1.5rem;">
				{coffeeChat.bookingLinks.map(b => (
					<a href={b.url} target="_blank" rel="noopener noreferrer" class="list-item" style="padding: 0.65rem 1.25rem; text-decoration: none;">
						{b.label}
					</a>
				))}
			</div>
		</div>
	</div>
</Layout>

<style is:global>
	.hero-intro strong {
		color: var(--text-primary);
		font-weight: 600;
	}
</style>
